        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nclass User {\n  id\n  name\n  email\n  password\n  role\n  jenis_wajib_pajak\n  ---\n  hasMany DataPenghasilan\n  hasMany PPhCalculation\n}\n\nclass DataPenghasilan {\n  id\n  user_id\n  sumber\n  jumlah\n  periode\n  terverifikasi\n  ---\n  belongsTo User\n}\n\nclass PPhCalculation {\n  id\n  user_id\n  total_penghasilan\n  ptkp\n  penghasilan_kena_pajak\n  pph_terutang\n  status\n  ---\n  belongsTo User\n  hasMany StatusHistory\n  konfirmasi()\n  ajukanKoreksi()\n}\n\nclass StatusHistory {\n  id\n  pph_calculation_id\n  status_lama\n  status_baru\n  diubah_oleh\n  keterangan\n  ---\n  belongsTo PPhCalculation\n}\n\nclass PPhCalculatorService {\n  hitungPTKP()\n  hitungPenghasilanKenaPajak()\n  hitungPPhProgresif()\n}\n\nclass PPhController {\n  tampilkanDetail()\n  konfirmasi()\n  ajukanKoreksi()\n}\n\nclass AdminController {\n  kelolaDataWajibPajak()\n  verifikasiKoreksi()\n  setujuiTolakKoreksi()\n  lihatDashboardStatistik()\n}\n\nUser -- DataPenghasilan : 1 - N\nUser -- PPhCalculation : 1 - N\nPPhCalculation -- StatusHistory : 1 - N\n\nPPhController -- PPhCalculation\nPPhController -- PPhCalculatorService\nAdminController -- PPhCalculation\nAdminController -- StatusHistory\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="25QwSFVq2X1T-o_FOLSy-1">
