  <diagram id="yVoboHnvtz9puMextBWN" name="Flowchart Diagram">
    <mxGraphModel dx="1229" dy="676" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nstart\n\n:INPUT data_penghasilan;\n\n:ptkp = getPTKP(status_wp);\n:pkp = total_penghasilan - ptkp;\n\nif (pkp &lt;= 0) then (true)\n  :pph_terutang = 0;\nelse (false)\n  :pph_terutang = hitungTarifProgresif(pkp);\nendif\n\n:SET status = \&quot;pra_isi\&quot;;\n:STORE pph_calculations;\n\n:OUTPUT hasil_pra_isi;\n\nif (input_user == \&quot;konfirmasi\&quot;) then (true)\n  :SET status = \&quot;dikonfirmasi\&quot;;\n  :INSERT status_history;\n  :OUTPUT bukti_konfirmasi;\n  stop\n\nelse (false)\n  :SET status = \&quot;dikoreksi\&quot;;\n  :INSERT status_history;\n  :NOTIFY admin;\n\n  if (keputusan_admin == \&quot;setuju\&quot;) then (true)\n    :SET status = \&quot;dikonfirmasi\&quot;;\n    :INSERT status_history;\n    :NOTIFY wajib_pajak;\n    stop\n\n  else (false)\n    :SET status = \&quot;ditolak\&quot;;\n    :INSERT status_history;\n    :NOTIFY wajib_pajak;\n    stop\n  endif\nendif\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="tt94Wp9R9Qi7z_wOciJW-73">
