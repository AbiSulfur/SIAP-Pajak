        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\n\nactor \&quot;Pengguna Terdaftar\&quot; as Pengguna\nactor \&quot;Wajib Pajak\&quot; as WP\nactor \&quot;Admin\&quot; as Admin\n\nPengguna &lt;|-- WP\nPengguna &lt;|-- Admin\n\nrectangle \&quot;SIAP Pajak\&quot; {\n\n  &#39; Use case umum (dipakai kedua aktor)\n  usecase \&quot;Login\&quot; as UC1\n  usecase \&quot;Logout\&quot; as UC2\n  usecase \&quot;Kelola Profil Akun\&quot; as UC3\n  usecase \&quot;Ganti Kata Sandi\&quot; as UC4\n\n  &#39; Use case khusus Wajib Pajak\n  usecase \&quot;Daftar Akun Baru\&quot; as UC5\n  usecase \&quot;Input Data Penghasilan Manual\&quot; as UC6\n  usecase \&quot;Lihat Data Pra-isi PPh\&quot; as UC7\n  usecase \&quot;Lihat Detail Rincian Perhitungan\&quot; as UC8\n  usecase \&quot;Konfirmasi Data Pra-isi\&quot; as UC9\n  usecase \&quot;Ajukan Koreksi Data\&quot; as UC10\n  usecase \&quot;Lampirkan Dokumen Pendukung Koreksi\&quot; as UC11\n  usecase \&quot;Lihat Riwayat Status Pengajuan\&quot; as UC12\n  usecase \&quot;Unduh Bukti Konfirmasi\&quot; as UC13\n\n  &#39; Use case khusus Admin\n  usecase \&quot;Kelola Data Wajib Pajak\&quot; as UC14\n  usecase \&quot;Kelola Data Penghasilan\&quot; as UC15\n  usecase \&quot;Verifikasi Data Koreksi\&quot; as UC16\n  usecase \&quot;Setujui / Tolak Koreksi\&quot; as UC17\n  usecase \&quot;Kelola Master PTKP &amp; Tarif Pajak\&quot; as UC18\n  usecase \&quot;Lihat Dashboard Statistik\&quot; as UC19\n  usecase \&quot;Cetak Laporan Ringkasan\&quot; as UC20\n  usecase \&quot;Kirim Notifikasi ke Wajib Pajak\&quot; as UC21\n}\n\nPengguna --&gt; UC1\nPengguna --&gt; UC2\nPengguna --&gt; UC3\nPengguna --&gt; UC4\n\nWP --&gt; UC5\nWP --&gt; UC6\nWP --&gt; UC7\nWP --&gt; UC8\nWP --&gt; UC9\nWP --&gt; UC10\nWP --&gt; UC11\nWP --&gt; UC12\nWP --&gt; UC13\n\nAdmin --&gt; UC14\nAdmin --&gt; UC15\nAdmin --&gt; UC16\nAdmin --&gt; UC17\nAdmin --&gt; UC18\nAdmin --&gt; UC19\nAdmin --&gt; UC20\nAdmin --&gt; UC21\n\nUC9 .&gt; UC12 : &lt;&lt;include&gt;&gt;\nUC10 .&gt; UC12 : &lt;&lt;include&gt;&gt;\nUC10 .&gt; UC11 : &lt;&lt;extend&gt;&gt;\nUC17 .&gt; UC12 : &lt;&lt;include&gt;&gt;\nUC17 .&gt; UC21 : &lt;&lt;include&gt;&gt;\nUC7 .&gt; UC8 : &lt;&lt;extend&gt;&gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="68RyfCk0qHzLb0Hg0aT2-37">
